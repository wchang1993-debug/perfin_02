# Modelo de variáveis de ambiente — copie para .env e preencha com os valores reais.
# Este arquivo é versionado: use apenas valores fictícios aqui.
# Na Vercel, cadastre as variáveis do bloco "Vercel" (Settings → Environment Variables).

# ---------------------------------------------------------------- Vercel
# URL pública do Portal (sem barra no final). Mudou? Refaça o deploy (NEXT_PUBLIC_* entra no build).
NEXT_PUBLIC_SITE_URL=https://seu-app.vercel.app

# Supabase (projeto perfin_02)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Secret key (somente servidor; ignora o RLS — nunca prefixar com NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Google OAuth (mesmo client cadastrado no provedor Google do Supabase)
GOOGLE_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
# 32 bytes aleatórios em base64, para cifrar o refresh token do Google.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=troque-por-32-bytes-em-base64

# E-mails com acesso ao Portal, separados por vírgula
ADMIN_EMAILS=admin@exemplo.com,outra.pessoa@exemplo.com

# Gemini (somente servidor)
GEMINI_API_KEY=sua-chave-gemini
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------- GitHub Actions (Secrets/Variables)
# SUPABASE_URL=https://seu-projeto.supabase.co        (Secret)
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx      (Secret)
# COLETA_ANBIMA_B3_ATIVA=false                        (Variable; true só após validar licença)

# ---------------------------------------------------------------- Somente local (migrations)
SUPABASE_DB_PASSWORD=sua-senha
# Use a conexão do pooler (IPv4) se a conexão direta não resolver na sua rede:
# postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:sua-senha@db.seu-projeto.supabase.co:5432/postgres
